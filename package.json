{
  "name": "forge-orchestrator",
  "version": "0.0.1",
  "description": "Forge - an AI engineering control plane where multiple coding agents collaborate on one repository under a shared execution protocol.",
  "license": "MIT",
  "author": "mdsaif45",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "smoke": "electron scripts/smoke.cjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "check:router": "esbuild src/renderer/src/ipc.ts --bundle --format=esm --platform=node --outfile=scripts/build/renderer-ipc.js --log-level=warning && node scripts/router-check.mjs",
    "check": "npm run typecheck && npm run build && npm run check:router && npm run smoke && npm run check:ui",
    "check:ui": "electron scripts/ui-check.cjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
