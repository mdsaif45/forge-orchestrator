{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@forge/shared": ["packages/forge-shared/src/index.ts", "src/shared/index.ts"],
      "@forge/shared/*": ["packages/forge-shared/src/*", "src/shared/*"],
      "@forge/core": ["packages/forge-core/src/index.ts", "src/main/core/index.ts"],
      "@forge/core/*": ["packages/forge-core/src/*", "src/main/core/*"],
      "@forge/runtimes": ["packages/forge-runtimes/src/index.ts", "src/main/runtimes/index.ts"],
      "@forge/runtimes/*": ["packages/forge-runtimes/src/*", "src/main/runtimes/*"],
      "@forge/cli": ["packages/forge-cli/src/index.ts", "src/main/cli.ts"],
      "@forge/cli/*": ["packages/forge-cli/src/*", "src/main/*"],
      "@forge/desktop": ["packages/forge-desktop/src/index.ts", "src/main/index.ts"],
      "@forge/desktop/*": ["packages/forge-desktop/src/*", "src/main/*"],
      "@main/*": ["src/main/*"],
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.web.json"
    },
    {
      "path": "./tsconfig.test.json"
    }
  ]
}
