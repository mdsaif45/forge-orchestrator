{
  "name": "forge-orchestrator",
  "version": "0.0.1",
  "description": "Forge - an AI engineering control plane where multiple coding agents collaborate on one repository under a shared execution protocol.",
  "license": "MIT",
  "author": "mdsaif45",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "smoke": "electron scripts/smoke.cjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
