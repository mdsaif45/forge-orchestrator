{
  "name": "forge-orchestrator",
  "version": "0.2.0-alpha.2",
  "description": "Forge - an AI engineering control plane where multiple coding agents collaborate on one repository under a shared execution protocol.",
  "license": "MIT",
  "author": "mdsaif45",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:ui-dev": "node scripts/build-ui-dev.mjs",
    "setup": "node scripts/setup-native.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "electron scripts/smoke.cjs",
    "check:router": "esbuild src/renderer/src/ipc.ts --bundle --format=esm --platform=node --outfile=scripts/build/renderer-ipc.js --log-level=warning && node scripts/router-check.mjs",
    "check:ui": "npm run build:ui-dev && electron scripts/ui-check.cjs",
    "check:no-dev-code": "node scripts/check-no-dev-code.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:router && npm run check:docs && npm run smoke && npm run check:no-dev-code && npm run check:ui && npm run test:e2e",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate && node scripts/generate-migrations.mjs",
    "db:check": "drizzle-kit check",
    "setup:pty": "node scripts/setup-native.mjs --pty",
    "docs:diagram": "esbuild src/shared/domain/transitions.ts --bundle --format=esm --platform=node --outfile=scripts/build/transitions.js --log-level=warning && node scripts/generate-state-diagram.mjs",
    "check:docs": "esbuild src/shared/domain/transitions.ts --bundle --format=esm --platform=node --outfile=scripts/build/transitions.js --log-level=warning && node scripts/generate-state-diagram.mjs --check",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "node-pty": "^1.1.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
