{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@forge/shared": ["../../packages/forge-shared/src/index.ts"],
      "@forge/shared/*": ["../../packages/forge-shared/src/*"],
      "@forge/ui": ["./src/index.ts"],
      "@forge/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
