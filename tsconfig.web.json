{
  "extends": "./tsconfig.base.json",
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/api.ts", "packages/**/*"],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Vite's client types only — for `import.meta.env`, which gates development-only
    // code out of the release bundle (#103). Deliberately not "node": keeping Node
    // globals out of the renderer is the boundary the lint rules also enforce.
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "outDir": "node_modules/.tmp/tsc-web",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared": ["src/shared/domain/index.ts"],
      "@shared/*": ["src/shared/*"],
      "@forge/shared": ["packages/forge-shared/src/index.ts"],
      "@forge/shared/*": ["packages/forge-shared/src/*"],
      "@forge/core": ["packages/forge-core/src/index.ts"],
      "@forge/core/*": ["packages/forge-core/src/*"],
      "@forge/runtimes": ["packages/forge-runtimes/src/index.ts"],
      "@forge/runtimes/*": ["packages/forge-runtimes/src/*"],
      "@forge/cli": ["packages/forge-cli/src/index.ts"],
      "@forge/cli/*": ["packages/forge-cli/src/*"]
    }
  },
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"]
}
